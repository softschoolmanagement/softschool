# Copy to .env  (never commit .env)
PORT=3001
# Listen on localhost only: ONLY the Spring Boot backend should reach this service.
HOST=127.0.0.1
# Shared secret. Must be identical to WHATSAPP_API_KEY in the Spring Boot .env
# Generate: openssl rand -base64 32
API_KEY=change-me
# Where linked-session credentials are stored. BACK THIS UP / keep it on a persistent disk.
SESSIONS_DIR=./sessions
# Country code used when a parent's number is saved as 03xx... (Pakistan = 92)
DEFAULT_COUNTRY_CODE=92
# Anti-ban pacing: random wait between two messages from the same school number
MIN_DELAY_MS=4000
MAX_DELAY_MS=9000
# Hard cap per school number per day (protects the school's number from being flagged)
DAILY_LIMIT=400
