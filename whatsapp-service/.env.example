# Copy to .env  (never commit .env)
PORT=3001
# Listen on localhost only: ONLY the Spring Boot backend should reach this service.
HOST=127.0.0.1
# Shared secret. Must be identical to WHATSAPP_API_KEY in the Spring Boot .env
# Generate: openssl rand -base64 32
API_KEY=change-me
# Where linked-session credentials AND each school's waiting queue are stored. Keep it on a persistent disk.
SESSIONS_DIR=./sessions
# Country code used when a parent's number is saved as 03xx... (Pakistan = 92)
DEFAULT_COUNTRY_CODE=92

# ───────── Anti-ban safety (all optional; these are the defaults) ─────────
# Random wait between two messages from the same school number (each school has its OWN queue)
MIN_DELAY_MS=8000
MAX_DELAY_MS=16000
# 10+ waiting messages = bulk: gaps get extra random variation (quick follow-ups, slower ones, short distractions) and the batch is sent in shuffled order
BULK_FROM=10
# Never more than this many per number per day / per rolling hour. A school can set a LOWER daily limit in
# Settings, never a higher one.
DAILY_LIMIT=250
HOURLY_LIMIT=40
# After about this many messages in a row the number rests for 3-7 minutes
BATCH_SIZE=15
BATCH_PAUSE_MIN_MS=180000
BATCH_PAUSE_MAX_MS=420000
# One parent number gets at most this many messages a day; identical text to the same number is sent once
PER_RECIPIENT_DAILY=3
# Timezone used only to decide when the "day" rolls over for the daily limit counters (no sending-hours restriction)
SEND_TZ=Asia/Karachi
# A single message is sent immediately. If another message went out less than this many ms ago it counts as
# "in a row" and is queued instead (bulk requests with 2+ messages are always queued).
DIRECT_ROW_GAP_MS=30000
# A newly linked number starts at WARMUP_START messages/day and rises to DAILY_LIMIT over WARMUP_DAYS
WARMUP_DAYS=7
WARMUP_START=30
# Queue: max waiting messages per school, and how long one may wait before it is dropped as stale
MAX_QUEUE=5000
MAX_QUEUE_AGE_HOURS=72
# Longest allowed message, and messages accepted per API request
MAX_TEXT_LENGTH=1500
MAX_PER_REQUEST=500
# Requests per minute the gateway accepts from the backend (protects against runaway loops)
API_RATE_PER_MIN=1500
