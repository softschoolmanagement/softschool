# Copy to .env (never commit .env). Generate secrets with: openssl rand -base64 48
# Secrets shorter than 32 chars, or placeholder-looking ones, are REJECTED (feature stays disabled).

DB_URL=jdbc:mysql://localhost:3306/softschool
DB_USERNAME=
DB_PASSWORD=

ADMIN_SESSION_SECRET=
SCHOOL_SESSION_SECRET=
BIOMETRIC_SYNC_KEY=

SUPERADMIN_USERNAME=
# java com.softschool.backend.security.PasswordHashUtil "your-password"
SUPERADMIN_PASSWORD_HASH=

# REQUIRED in production: your real frontend origin(s), comma-separated, no wildcard
ALLOWED_ORIGINS=https://your-frontend.example.com
TRUSTED_PROXY_HOPS=1
